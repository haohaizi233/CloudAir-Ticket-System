<view class="container">

<!-- 网络状态提示 -->
<view class="network-offline-bar" wx:if="{{!isOnline}}">
  <text class="network-offline-text">网络已断开，部分功能不可用</text>
</view>

<!-- 新手引导提示 -->
<view class="guide-tip" wx:if="{{showGuide}}" animation="{{guideAnimation}}">
  <text class="guide-tip-text">输入出发地和目的地，选择日期后点击查询航班即可开始预订</text>
  <text class="guide-tip-close" bindtap="onCloseGuide">知道了</text>
</view>

<view class="header">
  <view class="header-user" bindtap="{{avatarUrl ? 'onGoProfile' : 'onGetUserProfile'}}">
    <block wx:if="{{avatarUrl}}">
      <image class="user-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
    </block>
    <block wx:else>
      <view class="user-avatar user-avatar-default">
        <text class="user-avatar-icon">👤</text>
      </view>
    </block>
    <view class="user-info-text">
      <text class="user-greeting">{{nickName}}</text>
      <text class="user-sub">{{avatarUrl ? '欢迎回来' : '点击登录'}}</text>
    </view>
  </view>
  <view class="header-brand">
    <text class="header-title">云端航空</text>
    <text class="header-sub">让飞行更简单</text>
  </view>
</view>

<view class="search-card">
  <view class="location-row">
    <view class="input-box">
      <text class="label">出发地</text>
      <input class="city-input" value="{{fromCity}}" bindinput="onInputFrom" bindfocus="onFocusFrom" placeholder="北京" />
    </view>
    <view class="icon-plane swap-btn {{swapRotated ? 'rotated' : ''}}" bindtap="onSwapCity">🔄</view>
    <view class="input-box">
      <text class="label">目的地</text>
      <input class="city-input" value="{{toCity}}" bindinput="onInputTo" bindfocus="onFocusTo" placeholder="上海" />
    </view>
  </view>

  <view class="divider"></view>

  <view class="date-row">
    <picker class="date-picker-box" mode="date" start="{{today}}" end="2099-12-31" bindchange="onDateChange">
      <view class="picker-content">
        <text class="date-label">出发日期：</text>
        <view class="date-value {{date ? '' : 'placeholder'}}">
          {{date || '日期不限'}}
        </view>
      </view>
    </picker>
    <view class="action-area">
      <view wx:if="{{date}}" class="clear-text-btn" catchtap="onClearDate">清除</view>
      <view wx:else class="arrow">></view>
    </view>
  </view>

  <!-- 日期快捷选择 -->
  <view class="quick-date-row">
    <view class="quick-date-btn {{date === today ? 'active' : ''}}" bindtap="onQuickDate" data-date="{{today}}">今天</view>
    <view class="quick-date-btn {{date === tomorrow ? 'active' : ''}}" bindtap="onQuickDate" data-date="{{tomorrow}}">明天</view>
    <view class="quick-date-btn {{date === dayAfter ? 'active' : ''}}" bindtap="onQuickDate" data-date="{{dayAfter}}">后天</view>
  </view>

  <view class="keyword-row">
    <text class="icon-search">🔍</text>
    <input
      class="keyword-input"
      value="{{keyword}}"
      bindinput="onInputKeyword"
      bindfocus="onFocusKeyword"
      placeholder="航班号/航司(选填)"
      placeholder-class="placeholder-style"
    />
    <view class="clear-keyword" wx:if="{{keyword}}" catchtap="onClearKeyword">✕</view>
  </view>

  <button class="btn-search {{searching ? 'searching' : ''}}" bindtap="onSearch" disabled="{{searching}}">
    <text wx:if="{{!searching}}">查询航班</text>
    <text wx:else>搜索中...</text>
  </button>
  <view class="btn-reset" wx:if="{{fromCity || toCity || date || keyword}}" bindtap="onResetSearch">清空条件</view>

  <!-- 热门城市 -->
  <view class="hot-cities" wx:if="{{cityTarget}}">
    <text class="hot-title">热门城市 (点击填入{{cityTarget === 'from' ? '出发地' : '目的地'}})</text>
    <view class="city-tags">
      <view class="city-tag" wx:for="{{hotCities}}" wx:key="*this" bindtap="onSelectCity" data-city="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 城市智能提示 -->
  <view class="city-suggestions" wx:if="{{showSuggestions && citySuggestions.length > 0}}">
    <view class="suggestion-item" wx:for="{{citySuggestions}}" wx:key="*this" bindtap="onSelectSuggestion" data-city="{{item}}">
      <text class="suggestion-city">{{item}}</text>
    </view>
  </view>

  <!-- 热门航线快捷标签 -->
  <view class="hot-routes-section">
    <text class="hot-routes-label">热门航线</text>
    <view class="hot-routes-tags">
      <view class="hot-route-tag" wx:for="{{hotRoutes}}" wx:key="index" bindtap="onQuickRoute" data-from="{{item.from}}" data-to="{{item.to}}">
        {{item.from}} → {{item.to}}
      </view>
    </view>
  </view>
</view>

<!-- 最近搜索快捷标签 -->
<view class="recent-section" wx:if="{{searchHistory.length > 0}}">
  <view class="recent-header">
    <text class="recent-title">最近搜索</text>
    <text class="recent-clear" bindtap="onClearHistory">清空</text>
  </view>
  <view class="recent-tags">
    <view class="recent-tag" wx:for="{{searchHistory.length > 8 ? searchHistory.slice(0, 8) : searchHistory}}" wx:key="label" bindtap="onTapHistory" data-record="{{item}}">
      <text class="recent-tag-text">{{item.label}}</text>
    </view>
  </view>
</view>

</view>
