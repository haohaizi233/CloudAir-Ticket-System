page {
  background-color: #f5f6fa;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 20px;
}

/* 新手引导 */
.guide-tip {
  width: 90%;
  background-color: #fff7e6;
  border: 1px solid #ffd591;
  border-radius: 12px;
  padding: 12px 15px;
  margin-top: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  opacity: 0;
  transform: translateY(-20px);
}

.guide-tip-text {
  font-size: 13px;
  color: #ad6800;
  flex: 1;
  line-height: 1.5;
}

.guide-tip-close {
  font-size: 12px;
  color: #0052d9;
  font-weight: bold;
  padding: 4px 12px;
  background-color: #e6f7ff;
  border-radius: 12px;
  flex-shrink: 0;
  margin-left: 10px;
  line-height: 20px;
  white-space: nowrap;
}

.guide-tip-close:active {
  background-color: #d6e4ff;
}

/* Header */
.header {
  width: 100%;
  height: 200px;
  background: linear-gradient(135deg, #1e40af 0%, #2563eb 40%, #3b82f6 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  border-bottom-left-radius: 32px;
  border-bottom-right-radius: 32px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 6px 20px rgba(30, 64, 175, 0.25);
}

.header::before {
  content: '';
  position: absolute;
  top: -80px;
  right: -60px;
  width: 240px;
  height: 240px;
  background: radial-gradient(circle, rgba(255,255,255,0.15), transparent 65%);
  pointer-events: none;
}

.header::after {
  content: '';
  position: absolute;
  bottom: -100px;
  left: -60px;
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(147, 197, 253, 0.25), transparent 65%);
  pointer-events: none;
}

.header-user {
  position: absolute;
  top: 18px;
  left: 20px;
  display: flex;
  align-items: center;
  z-index: 2;
}

.user-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 2.5px solid rgba(255,255,255,0.85);
  background-color: #ffffff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.user-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border: 2.5px solid rgba(255,255,255,0.85);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.user-avatar-icon {
  font-size: 22px;
  line-height: 1;
  color: #2563eb;
}

.user-info-text {
  display: flex;
  flex-direction: column;
  margin-left: 12px;
}

.user-greeting {
  font-size: 15px;
  font-weight: 700;
  color: white;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  line-height: 1.4;
}

.user-sub {
  font-size: 11px;
  color: rgba(255,255,255,0.85);
  margin-top: 3px;
  line-height: 1.4;
}

.header-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}

.header-title {
  font-size: 26px;
  font-weight: 800;
  margin-bottom: 6px;
  letter-spacing: 4px;
  line-height: 1.4;
}

.header-sub {
  font-size: 13px;
  opacity: 0.8;
  line-height: 1.4;
}

/* 搜索卡片 */
.search-card {
  width: 90%;
  background: white;
  border-radius: 12px;
  padding: 22px 20px;
  margin-top: -50px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1), 0 2px 6px rgba(0, 0, 0, 0.05);
  z-index: 10;
  position: relative;
}

.location-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.input-box {
  display: flex;
  flex-direction: column;
  flex: 1;
  align-items: center;
}

.label {
  font-size: 12px;
  color: #999;
  margin-bottom: 5px;
  line-height: 1.4;
}

.city-input {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  border-bottom: 1px solid #eee;
  padding-bottom: 5px;
  text-align: center;
  width: 100%;
  line-height: 1.4;
}

.icon-plane {
  font-size: 24px;
  color: #0052d9;
}

.swap-btn {
  padding: 5px;
  border-radius: 50%;
  transition: transform 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 8px;
  flex-shrink: 0;
}

.swap-btn.rotated {
  transform: rotate(180deg);
}

.divider {
  height: 1px;
  background-color: #f0f0f0;
  margin: 10px 0;
}

.quick-date-row {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
}

.quick-date-btn {
  flex: 1;
  text-align: center;
  height: 36px;
  line-height: 36px;
  font-size: 13px;
  color: #666;
  background-color: #f5f7fa;
  border-radius: 20px;
  border: 1px solid #eee;
  white-space: nowrap;
}

.quick-date-btn.active {
  color: #0052d9;
  background-color: #e6f7ff;
  border-color: #91caff;
  font-weight: bold;
}

.quick-date-btn:active {
  background-color: #e6f7ff;
}

.date-row {
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 0;
}

.date-picker-box {
  flex: 1;
}

.picker-content {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.date-label {
  font-size: 15px;
  color: #666;
  margin-right: 10px;
  line-height: 1.4;
  white-space: nowrap;
}

.date-value {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  white-space: nowrap;
}

.date-value.placeholder {
  color: #ccc;
  font-weight: normal;
}

.action-area {
  margin-left: 10px;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.clear-text-btn {
  font-size: 13px;
  color: #999;
  padding: 4px 10px;
  background-color: #f5f5f5;
  border-radius: 12px;
  line-height: 20px;
  white-space: nowrap;
}

.clear-text-btn:active {
  background-color: #e0e0e0;
}

.arrow {
  color: #ccc;
  font-size: 16px;
  line-height: 1;
}

.keyword-row {
  display: flex;
  align-items: center;
  background-color: #f5f7fa;
  padding: 10px 15px;
  border-radius: 12px;
  margin-bottom: 20px;
  border: 1px solid #eee;
  height: 44px;
  box-sizing: border-box;
}

.icon-search {
  margin-right: 10px;
  font-size: 16px;
  color: #999;
  line-height: 1;
  flex-shrink: 0;
}

.keyword-input {
  flex: 1;
  font-size: 14px;
  color: #333;
  height: 24px;
  line-height: 24px;
}

.clear-keyword {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background-color: #ccc;
  color: white;
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8px;
  line-height: 1;
  flex-shrink: 0;
}

.clear-keyword:active {
  background-color: #999;
}

.placeholder-style {
  color: #ccc;
  font-size: 14px;
}

/* 搜索按钮 */
.btn-search {
  background-color: #0052d9;
  color: white;
  border-radius: 20px;
  font-weight: bold;
  height: 48px;
  line-height: 48px;
  text-align: center;
  font-size: 16px;
  box-shadow: 0 4px 8px rgba(0, 82, 217, 0.3);
  padding: 0;
  white-space: nowrap;
}

.btn-search:active {
  background-color: #003bb3;
}

.btn-search.searching {
  background-color: #7faaeb;
  box-shadow: none;
}

.btn-reset {
  text-align: center;
  font-size: 13px;
  color: #999;
  margin-top: 10px;
  padding: 5px 0;
  line-height: 1.4;
}

.btn-reset:active {
  color: #666;
}

/* 热门城市 */
.hot-cities {
  margin-top: 15px;
  padding-top: 15px;
  border-top: 1px solid #f0f0f0;
}

.hot-title {
  font-size: 12px;
  color: #999;
  margin-bottom: 10px;
  display: block;
  line-height: 1.4;
}

.city-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.city-tag {
  font-size: 13px;
  color: #333;
  background-color: #f5f7fa;
  padding: 6px 14px;
  border-radius: 16px;
  border: 1px solid #eee;
  line-height: 1.4;
  white-space: nowrap;
}

.city-tag:active {
  background-color: #e6f7ff;
  color: #0052d9;
  border-color: #91caff;
}

/* 城市智能提示 */
.city-suggestions {
  margin-top: 10px;
  background-color: white;
  border-radius: 12px;
  border: 1px solid #d6e4ff;
  overflow: hidden;
}

.suggestion-item {
  padding: 10px 15px;
  border-bottom: 1px solid #f5f5f5;
  font-size: 14px;
  color: #333;
  line-height: 1.4;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-item:active {
  background-color: #f0f5ff;
}

.suggestion-city {
  font-weight: 500;
}

/* 热门航线 */
.hot-routes-section {
  margin-top: 15px;
  padding-top: 15px;
  border-top: 1px solid #f0f0f0;
}

.hot-routes-label {
  font-size: 12px;
  color: #999;
  margin-bottom: 8px;
  display: block;
  line-height: 1.4;
}

.hot-routes-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.hot-route-tag {
  font-size: 12px;
  color: #0052d9;
  background-color: #f0f5ff;
  padding: 6px 12px;
  border-radius: 16px;
  border: 1px solid #d6e4ff;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
}

.hot-route-tag:active {
  background-color: #d6e4ff;
}

/* 最近搜索 */
.recent-section {
  width: 90%;
  margin-top: 16px;
}

.recent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.recent-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.recent-clear {
  font-size: 13px;
  color: #999;
  line-height: 1.4;
}

.recent-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.recent-tag {
  background-color: white;
  border: 1px solid #d6e4ff;
  border-radius: 16px;
  padding: 6px 14px;
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.recent-tag-text {
  font-size: 13px;
  color: #0052d9;
  font-weight: 500;
  line-height: 1.4;
}

.recent-tag:active {
  background-color: #e6f7ff;
}
