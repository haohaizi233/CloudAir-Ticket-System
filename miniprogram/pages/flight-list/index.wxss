  flex: 1;
}

.skeleton-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #f3f4f6;
  padding-top: 16px;
}

.skeleton-line {
  background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 37%, #f3f4f6 63%);
  background-size: 400% 100%;
  animation: skeletonShimmer 1.4s ease infinite;
  border-radius: 6px;
  height: 14px;
  margin-bottom: 8px;
}

.skeleton-line.sm { width: 40px; height: 12px; }
.skeleton-line.md { width: 60px; }
.skeleton-line.lg { width: 50px; height: 20px; }
.skeleton-line.xs { width: 30px; height: 10px; }
.skeleton-line.price { width: 70px; height: 24px; margin-bottom: 0; }
.skeleton-line.btn { width: 60px; height: 30px; border-radius: 15px; margin-bottom: 0; }

@keyframes skeletonShimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ===================== LOADING SPINNER ===================== */
.loading-spinner {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40px 0;
}

.spinner-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  margin: 0 5px;
  animation: spinnerBounce 1.4s ease-in-out infinite;
}

.spinner-dot:nth-child(2) {
  animation-delay: 0.16s;
}

.spinner-dot:nth-child(3) {
  animation-delay: 0.32s;
}

@keyframes spinnerBounce {
  0%, 80%, 100% {
    transform: scale(0.5);
    opacity: 0.3;
  }
  40% {
    transform: scale(1.1);
    opacity: 1;
  }
}

