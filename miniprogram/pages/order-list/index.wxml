<!-- pages/order-list/index.wxml -->
<view class="container" bindtap="onCloseSwipe">
  
  <!-- 退票成功动画遮罩 -->
  <view class="refund-success-overlay" wx:if="{{refundSuccess}}">
    <text class="refund-success-icon">✅</text>
    <text class="refund-success-text">退票成功</text>
    <text class="refund-success-sub">座位已释放</text>
  </view>
  
  <!-- 搜索栏 -->
  <view class="search-bar" wx:if="{{!loading && allOrders.length > 0}}">
    <text class="search-icon">🔍</text>
    <input 
      class="search-input" 
      placeholder="搜索航班号/城市/座位号" 
      value="{{searchKeyword}}" 
      bindinput="onSearchInput"
      bindblur="onSearchBlur"
    />
    <text class="search-clear" wx:if="{{searchKeyword}}" catchtap="onClearSearch">✕</text>
    <!-- 搜索建议下拉 -->
    <view class="search-suggestions" wx:if="{{showSearchSuggestions && searchSuggestions.length > 0}}">
      <view class="suggestion-item" wx:for="{{searchSuggestions}}" wx:key="text" bindtap="onTapSearchSuggestion" data-suggestion="{{item}}">
        <text class="suggestion-type">{{item.type === 'flight' ? '✈' : '📍'}}</text>
        <view class="suggestion-content">
          <text class="suggestion-text">{{item.text}}</text>
          <text class="suggestion-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索历史标签 -->
  <view class="order-search-history" wx:if="{{orderSearchHistory.length > 0 && !searchKeyword}}">
    <view class="osh-header">
      <text class="osh-title">搜索历史</text>
      <text class="osh-clear" bindtap="onClearOrderSearchHistory">清空</text>
    </view>
    <view class="osh-tags">
      <text class="osh-tag" wx:for="{{orderSearchHistory}}" wx:key="*this" bindtap="onTapOrderSearchHistory" data-keyword="{{item}}">{{item}}</text>
    </view>
  </view>

  <!-- 金额统计 -->
  <view class="price-stats" wx:if="{{!loading && allOrders.length > 0}}">
    <view class="price-stat-item">
      <text class="price-stat-label">总消费</text>
      <text class="price-stat-value">¥{{priceStats.total}}</text>
    </view>
    <view class="price-stat-divider"></view>
    <view class="price-stat-item">
      <text class="price-stat-label">待出行</text>
      <text class="price-stat-value price-stat-blue">¥{{priceStats.paid}}</text>
    </view>
    <view class="price-stat-divider"></view>
    <view class="price-stat-item">
      <text class="price-stat-label">已退票</text>
      <text class="price-stat-value price-stat-gray">¥{{priceStats.refunded}}</text>
    </view>
  </view>

  <!-- 状态筛选栏 -->
  <view class="filter-bar">
    <view class="filter-tabs">
      <view class="filter-item {{filterStatus === 'all' ? 'active' : ''}}" bindtap="onFilterChange" data-status="all">
        <text>全部</text>
        <text class="filter-count" wx:if="{{filterCounts.all > 0}}">{{filterCounts.all}}</text>
      </view>
      <view class="filter-item {{filterStatus === 'paid' ? 'active' : ''}}" bindtap="onFilterChange" data-status="paid">
        <text>已支付</text>
        <text class="filter-count" wx:if="{{filterCounts.paid > 0}}">{{filterCounts.paid}}</text>
      </view>
      <view class="filter-item {{filterStatus === 'refunded' ? 'active' : ''}}" bindtap="onFilterChange" data-status="refunded">
        <text>已退票</text>
        <text class="filter-count" wx:if="{{filterCounts.refunded > 0}}">{{filterCounts.refunded}}</text>
      </view>
    </view>
    <view class="filter-actions-row">
      <view class="batch-toggle" bindtap="onToggleBatchMode">{{batchMode ? '取消' : '批量'}}</view>
      <view class="export-toggle" bindtap="onExportOrders">导出</view>
      <view class="filter-toggle-btn {{showFilterPanel ? 'filter-active' : ''}}" bindtap="onToggleFilterPanel">筛选</view>
    </view>
  </view>

  <!-- 高级筛选面板 -->
  <view class="advanced-filter-panel" wx:if="{{showFilterPanel}}">
    <view class="filter-row">
      <text class="filter-row-label">航线</text>
      <input class="filter-route-input" placeholder="输入城市名筛选" value="{{filterRoute}}" bindinput="onFilterRouteInput" />
    </view>
    <view class="filter-row">
      <text class="filter-row-label">时间</text>
      <view class="filter-date-btns">
        <view class="filter-date-btn {{filterDateRange === 'week' ? 'date-active' : ''}}" bindtap="onFilterDateRange" data-range="week">近一周</view>
        <view class="filter-date-btn {{filterDateRange === 'month' ? 'date-active' : ''}}" bindtap="onFilterDateRange" data-range="month">近一月</view>
        <view class="filter-date-btn {{filterDateRange === 'quarter' ? 'date-active' : ''}}" bindtap="onFilterDateRange" data-range="quarter">近三月</view>
      </view>
    </view>
    <view class="filter-reset-btn" bindtap="onResetFilters">重置筛选</view>
  </view>

  <!-- 批量操作栏 -->
  <view class="batch-bar" wx:if="{{batchMode && selectedOrders.length > 0}}">
    <text class="batch-info">已选 {{selectedOrders.length}} 个订单</text>
    <view class="batch-btn batch-refund" bindtap="onBatchRefund">批量退票</view>
  </view>

  <!-- 排序栏 -->
  <view class="order-sort-bar" wx:if="{{!loading && allOrders.length > 0 && !batchMode}}">
    <view class="sort-item {{orderSortBy === 'default' ? 'sort-active' : ''}}" bindtap="onOrderSort" data-sort="default">默认</view>
    <view class="sort-item {{orderSortBy === 'priceAsc' ? 'sort-active' : ''}}" bindtap="onOrderSort" data-sort="priceAsc">价格↑</view>
    <view class="sort-item {{orderSortBy === 'priceDesc' ? 'sort-active' : ''}}" bindtap="onOrderSort" data-sort="priceDesc">价格↓</view>
    <view class="sort-item {{orderSortBy === 'timeDesc' ? 'sort-active' : ''}}" bindtap="onOrderSort" data-sort="timeDesc">最新</view>
    <view class="view-toggle-btn" bindtap="onToggleViewMode">{{viewMode === 'card' ? '时间线' : '卡片'}}</view>
  </view>

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="skeleton-order" wx:for="{{3}}" wx:key="index">
      <view class="skeleton-header">
        <view class="skeleton-circle"></view>
        <view class="skeleton-line name"></view>
        <view class="skeleton-line tag"></view>
      </view>
      <view class="skeleton-body">
        <view class="skeleton-line route"></view>
        <view class="skeleton-line info"></view>
        <view class="skeleton-line seat"></view>
      </view>
      <view class="skeleton-footer">
        <view class="skeleton-line price"></view>
        <view class="skeleton-line btn"></view>
      </view>
    </view>
  </block>

  <block wx:elif="{{orderList.length > 0 && viewMode === 'card'}}">
    <view class="swipe-wrapper" wx:for="{{orderList}}" wx:key="_id">
      <view 
        class="swipe-content" 
        style="transform: translateX({{item.translateX || 0}}px);"
        bindtouchstart="onTouchStart" 
        bindtouchmove="onTouchMove" 
        bindtouchend="onTouchEnd"
        data-index="{{index}}"
      >
        <view class="order-card" bindtap="onCardTap" bindlongpress="onLongPress" data-order="{{item}}">

          <!-- 批量选择复选框 -->
          <view class="batch-checkbox" wx:if="{{batchMode}}" catchtap="onToggleSelectOrder" data-order="{{item}}">
            <view class="checkbox-icon {{item.isSelected ? 'checked' : ''}}">
              <text wx:if="{{item.isSelected}}">✓</text>
            </view>
          </view>

          <!-- 头部：订单号与状态 -->
          <view class="card-header">
            <view class="user-info-small">
              <text class="flight-no-badge">{{item.flight_info.flight_no}}</text>
              <image 
                class="small-avatar" 
                src="{{currentUser.avatarUrl || item.passenger_avatar}}" 
                mode="aspectFill"
              ></image>
              <text class="passenger-name">
                {{currentUser.nickName || item.passenger_name}}
              </text>
            </view>
            
            <text class="status-tag {{item.status == 1 ? 'paid' : 'refunded'}}">
              {{item.status == 1 ? '已支付' : '已退票'}}
            </text>
          </view>

          <!-- 内容：航班信息 -->
          <view class="card-body">
            <view class="flight-row">
              <text class="city">{{item.flight_info.origin}}</text>
              <view class="flight-arrow">
                <view class="flight-arrow-line"></view>
                <text class="flight-arrow-icon">✈</text>
                <view class="flight-arrow-line"></view>
              </view>
              <text class="city">{{item.flight_info.dest}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">航班:</text><text class="info-value">{{item.flight_info.flight_no}}</text>
              <text class="info-label">日期:</text><text class="info-value">{{item.flight_info.dept_time}}</text>
            </view>
            <view class="seat-info">
              座位号：<text class="seat-no">{{item.seat_no}}</text>
            </view>
            <view class="order-time" wx:if="{{item.create_time}}">
              下单时间：{{item.create_time_str}}
            </view>
            <!-- 订单状态时间线 -->
            <view class="order-timeline">
              <view class="timeline-item timeline-done">
                <view class="timeline-dot"></view>
                <view class="timeline-content">
                  <text class="timeline-label">下单成功</text>
                  <text class="timeline-time">{{item.create_time_str}}</text>
                </view>
              </view>
              <view class="timeline-item {{item.status == 1 ? 'timeline-current' : 'timeline-done'}}">
                <view class="timeline-dot"></view>
                <view class="timeline-content">
                  <text class="timeline-label">{{item.status == 1 ? '待出行' : '已支付'}}</text>
                  <text class="timeline-time" wx:if="{{item.status == 1}}">等待出发</text>
                </view>
              </view>
              <view class="timeline-item {{item.status == 2 ? 'timeline-done' : 'timeline-pending'}}" wx:if="{{item.status == 2}}">
                <view class="timeline-dot"></view>
                <view class="timeline-content">
                  <text class="timeline-label">已退票</text>
                  <text class="timeline-time">退款完成</text>
                </view>
              </view>
            </view>
            <view class="order-id-row">
              <text class="order-id-label">订单号：</text>
              <text class="order-id-value">{{item._id}}</text>
              <text class="copy-order-id" catchtap="onCopyOrderId" data-id="{{item._id}}">复制</text>
            </view>
          </view>

          <!-- 底部：操作栏 -->
          <view class="card-footer">
            <text class="price">¥{{item.price}}</text>
            
            <view class="btn-group">
              <button 
                wx:if="{{item.status == 1}}" 
                class="btn-code" 
                size="mini" 
                catchtap="onShowCode" 
                data-order="{{item}}"
              >
                出示登机码
              </button>

              <button 
                wx:if="{{item.status == 1}}" 
                class="btn-refund" 
                size="mini" 
                catchtap="onRefund" 
                data-order="{{item}}"
              >
                申请退票
              </button>
            </view> 
          </view> 
        </view>
      </view>
      <!-- 滑动操作按钮 -->
      <view class="swipe-action" wx:if="{{item.status == 1}}" catchtap="onRefund" data-order="{{item}}">
        <text>退票</text>
      </view>
      <view class="swipe-action swipe-delete" wx:if="{{item.status == 2}}" catchtap="onDeleteOrder" data-order="{{item}}">
        <text>删除</text>
      </view>
    </view>
  </block>

  <!-- 时间线视图 -->
  <block wx:if="{{!loading && viewMode === 'timeline' && orderList.length > 0}}">
    <view class="timeline-view">
      <block wx:for="{{timelineGroups}}" wx:key="date">
        <view class="tl-date-header">
          <view class="tl-date-dot"></view>
          <text class="tl-date-text">{{item.date}}</text>
          <text class="tl-date-count">{{item.orders.length}}个订单</text>
        </view>
        <view class="tl-orders">
          <view class="tl-order-item" wx:for="{{item.orders}}" wx:for-item="order" wx:key="_id" bindtap="onTimelineOrderTap" data-id="{{order._id}}">
            <view class="tl-order-line"></view>
            <view class="tl-order-dot {{order.statusClass}}"></view>
            <view class="tl-order-card">
              <view class="tl-order-header">
                <text class="tl-flight-no">{{order.flightNo}}</text>
                <text class="tl-status-tag {{order.statusClass}}">{{order.statusText}}</text>
              </view>
              <view class="tl-order-route">
                <text class="tl-city">{{order.origin}}</text>
                <text class="tl-route-arrow">✈</text>
                <text class="tl-city">{{order.dest}}</text>
              </view>
              <view class="tl-order-info">
                <text class="tl-info-item">座位: {{order.seatNo}}</text>
                <text class="tl-info-item tl-price">¥{{order.price}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>

  <!-- 底部提示 -->
  <view class="list-footer" wx:if="{{!loading && orderList.length > 0}}">
    <text class="footer-text">— 共 {{orderList.length}} 条订单 —</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading}}" class="empty-state">
    <text class="empty-icon">📭</text>
    <text class="empty-title" wx:if="{{searchKeyword}}">未找到匹配"{{searchKeyword}}"的订单</text>
    <text class="empty-title" wx:elif="{{filterStatus === 'all'}}">暂无订单</text>
    <text class="empty-title" wx:elif="{{filterStatus === 'paid'}}">暂无待出行订单</text>
    <text class="empty-title" wx:else>暂无退票记录</text>
    <text class="empty-sub" wx:if="{{searchKeyword}}">尝试更换关键词搜索</text>
    <text class="empty-sub" wx:else>去首页搜索航班开始预订吧</text>
    <button class="btn-go-home" bindtap="onGoHome" wx:if="{{!searchKeyword && filterStatus === 'all'}}">去预订航班</button>
    <button class="btn-go-home" bindtap="onClearSearch" wx:if="{{searchKeyword}}">清除搜索</button>
  </view>

  <!-- 导出弹窗 -->
  <view class="modal-mask" wx:if="{{showExportModal}}" bindtap="onCloseExport">
    <view class="export-modal" catchtap="">
      <view class="export-header">
        <text class="export-title">订单导出</text>
        <text class="export-close" bindtap="onCloseExport">×</text>
      </view>
      <scroll-view class="export-content" scroll-y="true">
        <text class="export-text" selectable="true">{{exportText}}</text>
      </scroll-view>
      <view class="export-actions">
        <view class="export-btn export-copy" bindtap="onCopyExport">复制到剪贴板</view>
        <view class="export-btn export-share" open-type="share">分享给好友</view>
      </view>
    </view>
  </view>

  <!-- 订单详情弹窗 -->
  <view class="modal-mask" wx:if="{{showOrderDetail}}" bindtap="onCloseOrderDetail">
    <view class="order-detail-modal" catchtap="">
      <view class="detail-modal-header">
        <text class="detail-modal-title">订单详情</text>
        <text class="detail-modal-close" bindtap="onCloseOrderDetail">×</text>
      </view>
      <scroll-view class="detail-modal-body" scroll-y="true">
        <view class="detail-modal-status">
          <text class="detail-status-tag {{detailOrder.status == 1 ? 'paid' : 'refunded'}}">{{detailOrder.status == 1 ? '已支付' : '已退票'}}</text>
        </view>
        <view class="detail-modal-route">
          <text class="detail-origin">{{detailOrder.flight_info.origin}}</text>
          <text class="detail-arrow">✈️</text>
          <text class="detail-dest">{{detailOrder.flight_info.dest}}</text>
        </view>
        <view class="detail-info-grid">
          <view class="detail-info-cell">
            <text class="detail-info-label">航班号</text>
            <text class="detail-info-value">{{detailOrder.flight_info.flight_no}}</text>
          </view>
          <view class="detail-info-cell">
            <text class="detail-info-label">出发时间</text>
            <text class="detail-info-value">{{detailOrder.flight_info.dept_time}}</text>
          </view>
          <view class="detail-info-cell">
            <text class="detail-info-label">座位号</text>
            <text class="detail-info-value seat-value">{{detailOrder.seat_no}}</text>
          </view>
          <view class="detail-info-cell">
            <text class="detail-info-label">乘客</text>
            <text class="detail-info-value">{{detailOrder.passenger_name}}</text>
          </view>
          <view class="detail-info-cell">
            <text class="detail-info-label">机型</text>
            <text class="detail-info-value">{{detailOrder.flight_info.plane_type || '-'}}</text>
          </view>
          <view class="detail-info-cell">
            <text class="detail-info-label">票价</text>
            <text class="detail-info-value price-value">¥{{detailOrder.price}}</text>
          </view>
        </view>
        <view class="detail-order-id">
          <text class="detail-order-label">订单号</text>
          <text class="detail-order-id-text">{{detailOrder._id}}</text>
          <text class="detail-copy-btn" catchtap="onCopyOrderId" data-id="{{detailOrder._id}}">复制</text>
        </view>
        <view class="detail-create-time" wx:if="{{detailOrder.create_time_str}}">
          <text>下单时间：{{detailOrder.create_time_str}}</text>
        </view>
      </scroll-view>
      <view class="detail-modal-footer">
        <view class="detail-modal-btn detail-view-code" bindtap="onShowCodeFromDetail" wx:if="{{detailOrder.status == 1}}">查看登机牌</view>
        <view class="detail-modal-btn detail-refund-btn" catchtap="onRefund" data-order="{{detailOrder}}" wx:if="{{detailOrder.status == 1}}">申请退票</view>
        <view class="detail-modal-btn detail-close-btn" bindtap="onCloseOrderDetail" wx:if="{{detailOrder.status == 2}}">关闭</view>
      </view>
    </view>
  </view>
</view>